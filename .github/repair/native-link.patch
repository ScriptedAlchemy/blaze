@@ -457,6 +457,28 @@ pub(crate) struct Planned {
     pub(crate) proc_macro: Option<PathBuf>,
 }
 
+impl Planned {
+    /// Attach a host library's judged script output before its native compiler context is
+    /// frozen. A build-script executable gets no output of its own; these crates are the
+    /// libraries it links, or a proc macro and its libraries, not binary/cdylib targets.
+    pub(crate) fn apply_library_script(&mut self, out_dir: &Path, output: &blaze_build_script::Output) {
+        use blaze_build_script::{apply::{Compile, Linked}, unit::{Package, Target}};
+
+        self.out_dir = Some(out_dir.to_owned());
+        self.env.insert("OUT_DIR".into(), out_dir.display().to_string());
+        self.env.extend(output.env.iter().cloned());
+        self.cfg.extend(output.cfgs.iter().cloned());
+        // The link trusts native-unit flags and must not reread mutable script output.
+        // Use the same Cargo rule and ordering as the ordinary compile path, preserving
+        // library modifiers and excluding arguments meant only for binaries or cdylibs.
+        let target = Target { kind: vec!["lib".into()], ..Target::default() };
+        self.codegen_flags.extend(
+            Compile::of(&Package::default(), &target, false, &[Linked { own: true, output }], &[])
+                .args(),
+        );
+    }
+}
