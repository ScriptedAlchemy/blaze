index 10e661060..fbeddb74e 100644
--- a/crates/ra-jit/src/scripts/tests.rs
+++ b/crates/ra-jit/src/scripts/tests.rs
@@ -1006,6 +1006,96 @@ fn ordinary_macro_descriptors_mark_roots_and_fresh_dependency_leaves() {
     let _ = std::fs::remove_dir_all(&base);
 }
 
+/// The descriptor and its private native unit must agree about the native libraries a
+/// build dependency's script named, even when it shadows OUT_DIR. The linker intentionally
+/// does not consult the live output file once the native context has been captured.
+#[cfg(unix)]
+#[test]
+fn ordinary_producer_native_context_keeps_judged_library_flags() {
+    use crate::cargo::own_script::{SourceMode, planned_description, with_mode};
+    use blaze_build_script::output::{LibraryPath, LinkArgTarget};
+    use std::ffi::{OsStr, OsString};
+
+    let base = tempfile::tempdir().unwrap();
+    let pkg = Fixture::at(base.path());
+    let env = BTreeMap::from([
+        ("CARGO_HOME".to_owned(), base.path().join("home").display().to_string()),
+        ("RUSTFLAGS".to_owned(), "--cfg host_user".to_owned()),
+    ]);
+    let asked = Asked {
+        env: &env,
+        build: 0,
+        profile: "dev",
+        config: &[],
+        host: HOST,
+        target: HOST,
+        explicit_target: false,
+        packages: None,
+        host_cargo: None,
+        shared: None,
+    };
+    let leases = Leases::default();
+    let runner = Runner::new(&leases, &pkg.cargo, &asked, pkg.sysroot.clone(), &pkg.cfg).unwrap();
+    let profile = runner.profile(pkg.package, UnitFor::new_host(true), &CompileKind::Host);
+    let out_dir = base.path().join("native output");
+    let native_search = format!("native={}", out_dir.display());
+    let output = blaze_build_script::Output {
+        library_paths: vec![
+            LibraryPath::External("native=/external".into()),
+            LibraryPath::CargoArtifact(native_search.clone().into()),
+        ],
+        library_links: vec!["dylib=saved_dynamic".into(), "static:+whole-archive=helper".into()],
+        linker_args: vec![
+            (LinkArgTarget::All, "-Wl,--as-needed".into()),
+            (LinkArgTarget::Bin, "must-not-reach-producer".into()),
+            (LinkArgTarget::Cdylib, "must-not-reach-proc-macro".into()),
+        ],
+        env: vec![("OUT_DIR".into(), "/native-script-marker".into())],
+        cfgs: vec!["native_ready".into()],
+        ..Default::default()
+    };
+    let done = Done {
+        out_dir: out_dir.clone(),
+        output,
+        fingerprint: 0,
+        generation: 0,
+        ran: false,
+        made: None,
+        links: None,
+    };
+    let script = runner.described(
+        pkg.package, "build_script_build", &pkg.root.join("build.rs"), &profile, &[], None,
+    ).unwrap();
+    let library = runner.described(
+        pkg.package, "gen", &pkg.root.join("lib.rs"), &profile, &[], Some(&done),
+    ).unwrap();
+    let mut expected = script.codegen_flags.clone();
+    expected.extend([
+        "-L".into(), native_search,
+        "-L".into(), "native=/external".into(),
+        "-l".into(), "dylib=saved_dynamic".into(),
+        "-l".into(), "static:+whole-archive=helper".into(),
+        "-C".into(), "link-arg=-Wl,--as-needed".into(),
+    ]);
+    assert_eq!(library.codegen_flags, expected);
+    assert!(library.cfg.iter().any(|cfg| cfg == "native_ready"));
+    assert!(!script.cfg.iter().any(|cfg| cfg == "native_ready"));
+    assert_eq!(library.out_dir.as_ref(), Some(&out_dir));
+    assert_eq!(library.env["OUT_DIR"], "/native-script-marker");
+    let script_flags = script.codegen_flags.clone();
+    let description = planned_description(&pkg.sysroot, vec![script, library]);
+    let project: serde_json::Value = serde_json::from_str(&with_mode(
+        description,
+        SourceMode::Cargo { root: &pkg.root, members: &[true, true], env: &[] },
+    ).unwrap()).unwrap();
+    let encoded: Vec<u8> = serde_json::from_value(project[blaze_wire::native::UNIT_FIELD].clone()).unwrap();
+    let units = blaze_wire::native::decode_units(&encoded).unwrap();
+    assert_eq!(units[&0].flags, script_flags.into_iter().map(OsString::from).collect::<Vec<_>>());
+    assert_eq!(units[&1].flags, expected.into_iter().map(OsString::from).collect::<Vec<_>>());
+    assert_eq!(units[&1].env[OsStr::new("OUT_DIR")], "/native-script-marker");
+    assert_eq!(project["crates"][1]["blaze_build_script_out_dir"], serde_json::json!(out_dir));
+}
