diff --git a/crates/ra-jit/build.rs b/crates/ra-jit/build.rs
index ccf3821e9..faf7715a7 100644
--- a/crates/ra-jit/build.rs
+++ b/crates/ra-jit/build.rs
@@ -1,10 +1,10 @@
 //! `RA_JIT_SOURCES`: what this build of ra-jit is built from, for the store to key what it
 //! keeps by (`ra_jit_store::built_from`). A hash of every file of the workspace's crates, the
 //! vendored ones included, of the manifest and lock file that pick the crates of crates.io, of
-//! the files outside them a crate compiles in, of the features, the target and whether debug
-//! assertions are on, which some of codegen checks under. The compiler that builds ra-jit is
-//! not: what ra-jit compiles does not depend on it, and the toolchain it compiles against is
-//! in the store's key apart. Two such builds of the same sources compile the same code into
+//! the files outside them a crate compiles in, of the features, target, effective cfg values
+//! and compiler flags (including debug assertions), which some of codegen checks under.
+//! The compiler that builds ra-jit is not: what ra-jit compiles does not depend on it, and
+//! the toolchain it compiles against is in the store's key apart. Two such builds of the same sources compile the same code into
 //! the store, wherever they are built. Outside the workspace, as a published crate builds, it
 //! is not set, and the store keys by the bytes of the executable.
 //!
@@ -49,7 +49,7 @@ fn source_identity(root: &Path) -> std::io::Result<String> {
         hash.update(&(bytes.len() as u64).to_le_bytes());
         hash.update(bytes);
     };
-    field(b"blaze-source-identity-v2");
+    field(b"blaze-source-identity-v3");
     for path in &files {
         let bytes = std::fs::read(path)?;
         let relative = path.strip_prefix(root).map_err(std::io::Error::other)?;
@@ -75,8 +75,29 @@ fn source_identity(root: &Path) -> std::io::Result<String> {
         .collect();
     features.sort();
     field(features.join(" ").as_bytes());
-    field(std::env::var("TARGET").unwrap_or_default().as_bytes());
-    field(&[u8::from(std::env::var_os("CARGO_CFG_DEBUG_ASSERTIONS").is_some())]);
+    field(std::env::var("TARGET").map_err(std::io::Error::other)?.as_bytes());
+    // Cargo supplies the package's effective cfg and encoded flags to this
+    // script. Equal sources with a different custom cfg, target feature, panic
+    // strategy, or other codegen setting are not the same compiler. Do not
+    // inspect arbitrary environment values (which may be private or native).
+    let mut configuration = std::collections::BTreeMap::new();
+    for (name, value) in std::env::vars_os() {
+        let Ok(name) = name.into_string() else { continue };
+        if name.starts_with("CARGO_CFG_") || name == "CARGO_ENCODED_RUSTFLAGS" {
+            let value = value
+                .into_string()
+                .map_err(|_| std::io::Error::other("non-Unicode compiler configuration"))?;
+            configuration.insert(name, value);
+        }
+    }
+    field(b"compiler-configuration");
+    field(&(configuration.len() as u64).to_le_bytes());
+    for (name, value) in configuration {
+        field(name.as_bytes());
+        // Keep encoded argument boundaries and presence versus absence. Trying
+        // to normalize flags can collapse distinct cfg/codegen settings.
+        field(value.as_bytes());
+    }
     Ok(hash.finish().iter().map(|byte| format!("{byte:02x}")).collect())
 }
 
diff --git a/harness/source_identity_test.py b/harness/source_identity_test.py
