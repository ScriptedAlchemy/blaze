@@ -32,7 +32,8 @@ class SourceIdentityTests(unittest.TestCase):
 
     def identity(self, root=None, **extra):
         env = {k: v for k, v in os.environ.items()
-               if not k.startswith("CARGO_FEATURE_") and k != "CARGO_CFG_DEBUG_ASSERTIONS"}
+               if not k.startswith(("CARGO_FEATURE_", "CARGO_CFG_"))
+               and k != "CARGO_ENCODED_RUSTFLAGS"}
         env.update(CARGO_WORKSPACE_DIR=str(root or self.root), TARGET="test-target")
         env.update(extra)
         result = subprocess.run([SCRIPT], env=env, capture_output=True, text=True,
@@ -160,6 +161,43 @@ class SourceIdentityTests(unittest.TestCase):
         self.addCleanup(path.chmod, 0o700)
         self.assertIsNone(self.identity())
 
+    def test_effective_custom_cfg_changes_compiler_identity(self):
+        original = self.identity(CARGO_CFG_COMPILER_MODE="first")
+        self.assertIsNotNone(original)
+        self.assertNotEqual(original, self.identity(CARGO_CFG_COMPILER_MODE="second"))
+        self.assertNotEqual(self.identity(), self.identity(CARGO_CFG_UNCHECKED_COMPILER=""))
+
+    def test_target_features_and_panic_strategy_change_identity(self):
+        self.assertNotEqual(self.identity(CARGO_CFG_TARGET_FEATURE="sse2"),
+                            self.identity(CARGO_CFG_TARGET_FEATURE="avx2,sse2"))
+        self.assertNotEqual(self.identity(CARGO_CFG_PANIC="abort"),
+                            self.identity(CARGO_CFG_PANIC="unwind"))
+
+    def test_effective_encoded_flags_and_argument_boundaries_are_preserved(self):
+        self.assertNotEqual(self.identity(), self.identity(CARGO_ENCODED_RUSTFLAGS=""))
+        self.assertNotEqual(self.identity(CARGO_ENCODED_RUSTFLAGS="--cfg\x1fmode_a"),
+                            self.identity(CARGO_ENCODED_RUSTFLAGS="--cfg\x1fmode_b"))
+        self.assertNotEqual(self.identity(CARGO_ENCODED_RUSTFLAGS="-C\x1fopt-level=2"),
+                            self.identity(CARGO_ENCODED_RUSTFLAGS="-C opt-level=2"))
+
+    def test_configuration_order_does_not_split_identity(self):
+        first = {"CARGO_CFG_A": "one", "CARGO_CFG_B": "two", "CARGO_ENCODED_RUSTFLAGS": "-C\x1fopt-level=2"}
+        self.assertEqual(self.identity(**first), self.identity(**dict(reversed(list(first.items())))))
+
+    @unittest.skipUnless(os.name == "posix", "Unix native configuration fixture")
+    def test_non_unicode_relevant_configuration_uses_binary_identity(self):
+        invalid = os.fsdecode(b"\xff")
+        self.assertIsNone(self.identity(CARGO_CFG_PRIVATE_MODE=invalid))
+        self.assertIsNone(self.identity(CARGO_ENCODED_RUSTFLAGS=invalid))
+        self.assertIsNone(self.identity(TARGET=invalid))
+
+    def test_ineffective_plain_flags_do_not_override_cargo_encoded_flags(self):
+        # Cargo removes RUSTFLAGS before executing a build script. A synthetic
+        # caller setting it must not override the recorded effective flags.
+        before = self.identity(CARGO_ENCODED_RUSTFLAGS="--cfg\x1fmode_a")
+        self.assertEqual(before, self.identity(CARGO_ENCODED_RUSTFLAGS="--cfg\x1fmode_a",
+                                               RUSTFLAGS="--cfg unrelated"))
+
     def test_missing_required_source_fact_uses_binary_identity(self):
         (self.root / "harness/toolchain").unlink()
         self.assertIsNone(self.identity())
