{
  "_doc": "Which checks a change runs (pr.yaml, job changes): an area runs when a changed file matches one of its `paths` and none of its `ignore` (fnmatch, where * crosses /). Changes to the CI itself run every area. The area that owns a check owns its entry. Contract: docs/reports/CI-fork.md.",
  "ci": {
    "paths": [
      ".github/workflows/pr.yaml",
      ".github/workflows/bundle.yaml",
      ".github/workflows/bundle-check.yaml",
      ".github/actions/bundle/*",
      ".github/actions/toolchain/*",
      ".github/scripts/bundle.py",
      ".github/scripts/changes.py",
      ".github/ci/*"
    ]
  },
  "dist": {
    "paths": [
      "crates/blaze-dist/**",
      "crates/blaze-dist-local/**",
      "crates/blaze-wire/**",
      "crates/blaze-spec/**",
      "crates/blaze-manifest/**",
      "crates/blaze-metadata/**",
      "crates/blaze-resolve/**",
      "crates/ra-jit/src/**",
      "crates/hir-ty-codegen/**",
      "vendor/rust-analyzer/crates/base-db/**",
      "vendor/rust-analyzer/crates/project-model/**",
      "vendor/rust-analyzer/crates/hir-expand/**",
      "vendor/rust-analyzer/crates/paths/**",
      "vendor/rust-analyzer/crates/vfs/**",
      "vendor/rust-analyzer/crates/vfs-notify/**",
      "vendor/rust-analyzer/crates/ide-db/**",
      "vendor/proc-macro-srv/**",
      "harness/dist/**",
      "harness/norustc.py",
      "harness/norustc_test.py",
      "Cargo.toml",
      "Cargo.lock",
      "flake.nix",
      "flake.lock",
      "nix/**",
      ".github/actions/toolchain/**",
      ".github/workflows/blaze-dist-review.yaml"
    ],
    "macos": true
  },
  "serve": {
    "paths": [
      "crates/blaze-serve/**",
      "crates/blaze-wire/**",
      "crates/blaze-metadata/**",
      "crates/blaze-manifest/**",
      "crates/blaze-resolve/**",
      "crates/hir-ty-codegen/**",
      "crates/ra-jit-store/**",
      "crates/ra-jit/**",
      "crates/blaze-spec/**",
      "vendor/rust-analyzer/crates/project-model/**",
      "vendor/proc-macro-srv/**",
      "vendor/rust-analyzer/crates/base-db/**",
      "vendor/rust-analyzer/crates/hir-expand/**",
      "vendor/rust-analyzer/crates/project-model/**",
      "vendor/rust-analyzer/crates/syntax/**",
      "vendor/rust-analyzer/crates/cfg/**",
      "vendor/rust-analyzer/crates/hir/**",
      "vendor/rust-analyzer/crates/hir-def/**",
      "vendor/rust-analyzer/crates/hir-ty/**",
      "vendor/rust-analyzer/crates/hir-ty-borrowck/**",
      "vendor/rust-analyzer/crates/paths/**",
      "vendor/rust-analyzer/crates/vfs/**",
      "vendor/rust-analyzer/crates/vfs-notify/**",
      "vendor/rust-analyzer/crates/ide-db/**",
      "vendor/rust-analyzer/crates/ide-diagnostics/**",
      "vendor/rust-analyzer/crates/load-cargo/**",
      "vendor/rust-analyzer/crates/proc-macro-api/**",
      "harness/**",
      "Cargo.toml",
      "Cargo.lock",
      ".github/workflows/blaze-serve-review.yaml"
    ]
  },
  "bench": {
    "paths": [
      "*"
    ],
    "ignore": [
      "site/*",
      "*.md",
      "harness/*"
    ]
  },
  "nix": {
    "paths": [
      "flake.nix",
      "flake.lock",
      "nix/**",
      "Cargo.lock",
      "**/Cargo.toml",
      ".github/workflows/nix-live.yaml"
    ]
  }
}
